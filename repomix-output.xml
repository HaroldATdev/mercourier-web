                            } else {
                                Swal.fire({icon: 'error', title: 'Error', text: response.data.message || 'Error desconocido'});
                            }
                        },
                        error: function() {
                            Swal.fire({icon: 'error', title: 'Error', text: 'Error de red.'});
                        }
                    });
                }
            });
