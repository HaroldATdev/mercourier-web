/**
 * MERC_Status_Filter
 * Encola status-filter.js con el mapa de estados via wp_localize_script.
 */
class MERC_Status_Filter {

	const STATUS_MAP = [
		'agencia'     => [ 'RECEPCIONADO','LISTO PARA SALIR','NO CONTESTA','EN RUTA','ENTREGADO','NO RECIBIDO','REPROGRAMADO','ANULADO' ],
