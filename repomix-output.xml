class Merc_Bloqueos_Ajax {

    public function __construct() {
        add_action('wp_ajax_merc_bloqueo_info', [$this, 'get_bloqueo_info']);
        add_action('wp_ajax_nopriv_merc_bloqueo_info', [$this, 'get_bloqueo_info']);
