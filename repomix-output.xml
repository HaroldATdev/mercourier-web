            error_log("   Shipment #" . $shipment->ID . " | pod_payment_methods(raw)=" . (is_scalar($raw_ppm) ? $raw_ppm : json_encode($raw_ppm)) . ", wpcargo_total_cobrar=" . var_export($raw_total_meta, true) . ", otros_meta=" . json_encode($found_other));

