		<!-- Pagar Remitentes -->
        <div class="col-md-4">
            <div class="merc-stat-box" style="background: #16a085;">
				<p>Por pagar remitentes</p>
                <h2>
                    S/. <?php 
                    // Mostrar la suma de los montos positivos por cliente
