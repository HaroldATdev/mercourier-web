erflow: hidden;\r\n  border: 1px solid #333;\r\n  border-bottom: 6px solid #49080A;\r\n  flex-shrink: 0;\r\n  transition: transform 0.4s ease, border-color 0.4s ease;\r\n}\r\n\r\n.merc-servicios-wrapper .servicio-card:hover {\r\n  transform: translateY(-12px);\r\n  border-color: #49080A;\r\n}\r\n\r\n.merc-servicios-wrapper .servicio-card img {\r\n  width: 100%;\r\n  height: 240px;\r\n  object-fit: cover;\r\n}\r\n\r\n.merc-servicios-wrapper .card-body { \r\n  padding: 35px; \r\n}\r\n\r\n.merc-servicios-wrapper .tag { \r\n  color: #ff5b5b; \r\n  font-size: 11px; \r\n  font-weight: bold; \r\n  letter-spacing: 3px; \r\n  text-transform: uppercase;\r\n}\r\n\r\n.merc-servicios-wrapper .card-body h3 { \r\n  color: #fff !important; \/* Aseguramos color blanco *\/\r\n  font-family: 'Montserrat', Sans-Serif; \r\n  margin: 15px 0; \r\n  font-size: 1.6rem; \r\n}\r\n\r\n.merc-servicios-wrapper .card-body p { \r\n  color: #ccc; \r\n  font-size: 1rem; \r\n  margin-bottom: 25px; \r\n  line-height: 1.7; \r\n}\r\n\r\n.merc-servicios-wrapper .btn-card {\r\n  display: inline-block;\r\n  padding: 14px 28px;\r\n  background: #49080A;\r\n  color: #fff !important;\r\n  text-decoration: none;\r\n  font-weight: bold;\r\n  border-radius: 8px;\r\n  font-size: 0.95rem;\r\n  transition: background 0.3s;\r\n}\r\n\r\n.merc-servicios-wrapper .btn-card:hover {\r\n  background: #e63946;\r\n}\r\n\r\n\/* --- ANIMACI\u00d3N MATEM\u00c1TICA --- *\/\r\n@keyframes merc-scroll-infinito {\r\n  0% { transform: translateX(0); }\r\n  100% { transform: translateX(calc((-420px - 80px) * 4)); }\r\n}\r\n\r\n.merc-servicios-wrapper .servicios-loop-container:hover .servicios-track {\r\n  animation-play-state: paused;\r\n}\r\n\r\n\/* ======== RESPONSIVE ======== *\/\r\n@media (max-width: 1024px) {\r\n  .merc-servicios-wrapper .servicio-card {\r\n    width: 350px;\r\n  }\r\n  @keyframes merc-scroll-infinito {\r\n    0% { transform: translateX(0); }\r\n    100% { transform: translateX(calc((-350px - 80px) * 4)); }\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .merc-servicios-wrapper .servicio-card {\r\n    width: 300px;\r\n  }\r\n  .merc-servicios-wrapper .servicios-track {\r\n    gap: 40px;\r\n  }\r\n  @keyframes merc-scroll-infinito {\r\n    0% { transform: translateX(0); }\r\n    100% { transform: translateX(calc((-300px - 40px) * 4)); }\r\n  }\r\n}\r\n<\/style>\r\n\r\n<script>\r\n(function() {\r\n  const servicios = [\r\n    {\r\n      img: 'https:\/\/mercourier.com\/wp-content\/uploads\/2026\/01\/IMAGENES-PAGINA-1024X1024.png',\r\n      alt: 'Merc Emprendedor',\r\n      titulo: 'MERC EMPRENDEDOR',\r\n      descripcion: '<strong>MERC EMPRENDEDOR<\/strong> es un servicio con tarifa plana de S\/10. Ofrece recojo matutino, entrega por la tarde y seguro gratuito hasta S\/300.',\r\n      enlace: 'https:\/\/mercourier.com\/merc-emprendedor\/'\r\n    },\r\n    {\r\n      img: 'https:\/\/mercourier.com\/wp-content\/uploads\/2026\/02\/3.png',\r\n      alt: 'Merc Agencia',\r\n      titulo: 'MERC AGENCIA',\r\n      descripcion: '<strong>MERC AGENCIA<\/strong> ofrece env\u00edos con tarifa plana de S\/8. Recibe pedidos hasta las 12:30 pm e incluye seguro de S\/300.',\r\n      enlace: 'https:\/\/mercourier.com\/merc-agencia\/'\r\n    },\r\n    {\r\n      img: 'https:\/\/mercourier.com\/wp-content\/uploads\/2026\/02\/4.png',\r\n      alt: 'Merc Express',\r\n      titulo: 'MERC EXPRESS',\r\n      descripcion: '<strong>MERC EXPRESS<\/strong> es entrega personalizada en 1 a 2 horas. Cuesta S\/2.50 por km y ofrece seguro de S\/300.',\r\n      enlace: 'https:\/\/mercourier.com\/merc-express\/'\r\n    },\r\n    {\r\n      img: 'https:\/\/mercourier.com\/wp-content\/uploads\/2026\/01\/11.png',\r\n      alt: 'Merc Fullfillment',\r\n      titulo: 'MERC FULLFILLMENT',\r\n      descripcion: '<strong>MERC FULFILLMENT<\/strong> gestiona almacenamiento e inventario. Ofrece entregas el mismo d\u00eda y seguro de S\/300.',\r\n      enlace: 'https:\/\/mercourier.com\/merc-fullfitment\/'\r\n    }\r\n  ];\r\n\r\n  function crearCard(servicio) {\r\n    return `\r\n      <div class=\"servicio-card\">\r\n        <img src=\"${servicio.img}\" alt=\"${servicio.alt}\">\r\n        <div class=\"card-body\">\r\n          <span class=\"tag\">SERVICIO ESPECIALIZADO<\/span>\r\n          <h3>${servicio.titulo}<\/h3>\r\n          <p>${servicio.descripcion}<\/p>\r\n          <a href=\"${servicio.enlace}\" class=\"btn-card\">Saber m\u00e1s<\/a>\r\n        <\/div>\r\n      <\/div>\r\n    `;\r\n  }\r\n\r\n  const track = document.querySelector('.merc-servicios-wrapper .servicios-track');\r\n  if (!track) return;\r\n\r\n  let cardsHTML = '';\r\n  \/\/ Bucle infinito\r\n  for (let i = 0; i < 10; i++) {\r\n    servicios.forEach(servicio => {\r\n      cardsHTML += crearCard(servicio);\r\n    });\r\n  }\r\n  \r\n  track.innerHTML = cardsHTML;\r\n\r\n  \/\/ L\u00f3gica de arrastre\r\n  const slider = document.querySelector('.merc-servicios-wrapper .servicios-loop-container');\r\n  let isDown = false;\r\n  let startX;\r\n  let scrollLeft;\r\n\r\n  slider.addEventListener('mousedown', (e) => {\r\n    isDown = true;\r\n    slider.style.cursor = 'grabbing';\r\n    track.style.animationPlayState = 'paused';\r\n    startX = e.pageX - slider.offsetLeft;\r\n    scrollLeft = slider.scrollLeft;\r\n  });\r\n\r\n  const endDragging = () => {\r\n    isDown = false;\r\n    slider.style.cursor = 'grab';\r\n    if (!slider.matches(':hover')) track.style.animationPlayState = 'running';\r\n  };\r\n\r\n  slider.addEventListener('mouseleave', endDragging);\r\n  slider.addEventListener('mouseup', endDragging);\r\n\r\n  slider.addEventListener('mousemove', (e) => {\r\n    if (!isDown) return;\r\n    e.preventDefault();\r\n    const x = e.pageX - slider.offsetLeft;\r\n    const walk = (x - startX) * 2;\r\n    slider.scrollLeft = scrollLeft - walk;\r\n  });\r\n})();\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-b7c2168 e-flex e-con-boxed elementor-invisible e-con e-parent\" data-id=\"b7c2168\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;animation&quot;:&quot;fadeIn&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-12da26a elementor-position-top elementor-widget elementor-widget-image-box\" data-id=\"12da26a\" data-element_type=\"widget\" data-widget_type=\"image-box.default\">\n\t\t\t\t\t<div class=\"elementor-image-box-wrapper\"><figure class=\"elementor-image-box-img\"><img width=\"55\" height=\"49\" src=\"https:\/\/mercourier.com\/wp-content\/uploads\/2021\/12\/home-page-icon-1-white.svg\" class=\"attachment-full size-full wp-image-685\" alt=\"\" \/><\/figure><div class=\"elementor-image-box-content\"><h5 class=\"elementor-image-box-title\">Brindamos un seguro para todos tus productos<\/h5><\/div><\/div>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-699aaf9 elementor-position-top elementor-widget elementor-widget-image-box\" data-id=\"699aaf9\" data-element_type=\"widget\" data-widget_type=\"image-box.default\">\n\t\t\t\t\t<div class=\"elementor-image-box-wrapper\"><figure class=\"elementor-image-box-img\"><img width=\"55\" height=\"56\" src=\"https:\/\/mercourier.com\/wp-content\/uploads\/2021\/12\/home-page-icon-2-white.svg\" class=\"attachment-full size-full wp-image-686\" alt=\"\" \/><\/figure><div class=\"elementor-image-box-content\"><h5 class=\"elementor-image-box-title\">Rembolsamos el valor de los productos extraviados<\/h5><\/div><\/div>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-295c058 elementor-position-top elementor-widget elementor-widget-image-box\" data-id=\"295c058\" data-element_type=\"widget\" data-widget_type=\"image-box.default\">\n\t\t\t\t\t<div class=\"elementor-image-box-wrapper\"><figure class=\"elementor-image-box-img\"><img width=\"49\" height=\"56\" src=\"https:\/\/mercourier.com\/wp-content\/upl