            ON p.ID = pm_fecha_reprog.post_id 
            AND pm_fecha_reprog.meta_key = 'wpcargo_pickup_date_picker'
        WHERE p.post_type = 'wpcargo_shipment'
        AND p.post_status = 'publish'
        AND pm_shipper.meta_value = '118'
    
